# LLM API Keys (fill in the ones you have)
MINIMAX_API_KEY=your_minimax_key_here
ZHIPUAI_API_KEY=your_zhipuai_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here

# LLM Endpoints (OpenAI-compatible)
MINIMAX_BASE_URL=https://api.minimax.chat/v1
ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Default LLM model (minimax-m2.7 / glm-5.1 / deepseek-v4-pro)
DEFAULT_MODEL=deepseek-v4-pro

# ASR Configuration
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Whisper API fallback (optional, uses OpenAI key)
WHISPER_API_KEY=

# Output directory for downloaded audio files
TEMP_DIR=./temp_audio
